                z-index: 9999;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
                gap: 1.5rem;
                scrollbar-width: none; 
            }
            .terminal-nav::-webkit-scrollbar { display: none; }
            .terminal-nav a { white-space: nowrap; font-size: 0.9rem; }
            .terminal-nav a::before { display: none; }
            .terminal-nav a:hover { transform: none; color: var(--accent-cyan); }
        }
    </style>
