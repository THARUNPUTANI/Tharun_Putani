            gap: 1.5rem;
            font-size: 1.5rem;
            margin-bottom: 3rem;
        }

        .social-links a {
            color: var(--text-muted);
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            color: var(--accent-cyan);
            transform: translateY(-4px) scale(1.1);
        }

        /* Desktop Navigation Links */
        .terminal-nav {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .terminal-nav a {
            font-family: 'Fira Code', monospace;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
        }

        .terminal-nav a::before {
            content: "🕷";
            font-size: 0.85rem;
            color: var(--accent-red);
            opacity: 0;
            transition: all 0.3s ease;
            transform: scale(0) rotate(-45deg);
        }

        .terminal-nav a:hover {
            color: #f6e6e6;
            transform: translateX(10px);
            text-shadow: 0 0 10px rgba(255, 0, 60, 0.5);
        }

        .terminal-nav a:hover::before {
            opacity: 1;
            transform: scale(1) rotate(0deg);
            text-shadow: 0 0 10px var(--accent-red);
        }

        /* Right Scrollable Content Pane */
        .right-pane {
            width: 62%;
            margin-left: 38%;
            padding: 5rem 4rem;
            display: flex;
            flex-direction: column;
            gap: 6rem;
        }

        section {
            scroll-margin-top: 5rem;
        }

        .section-title {
            font-family: 'Fira Code', monospace;
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .section-title::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient(to right, var(--accent-magenta), transparent);
        }

        /* =========================================
           CARDS (GLASSMORPHISM)
        ========================================= */
        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 1;
        }

        .card:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(30, 30, 50, 0.6);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(112, 0, 255, 0.15);
        }

        .card::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-violet));
            border-radius: 4px 0 0 4px;
        }

        .card h3 {
            font-size: 1.3rem;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .card .meta {
            font-family: 'Fira Code', monospace;
            font-size: 0.85rem;
            color: var(--accent-cyan);
            margin-bottom: 1.2rem;
            display: inline-block;
            background: rgba(0, 229, 255, 0.1);
            padding: 4px 10px;
            border-radius: 20px;
        }

        .card p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-top: 1rem;
        }

        .tag {
            font-family: 'Fira Code', monospace;
            font-size: 0.8rem;
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .card:hover .tag {
            border-color: var(--accent-magenta);
            background: rgba(255, 0, 127, 0.1);
        }

        .card-link {
            font-family: 'Fira Code', monospace;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--accent-cyan);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .card-link:hover {
            color: #fff;
            text-shadow: 0 0 10px var(--accent-cyan);
            transform: translateX(5px);
        }

        /* Scroll Animation */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(15px);
            justify-content: center;
            align-items: center;
            z-index: 2000;
            cursor: zoom-out;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active { display: flex; opacity: 1; }
        .modal-overlay img {
            max-width: 90vw; max-height: 90vh;
            border-radius: 16px;
            border: 2px solid var(--accent-cyan);
            box-shadow: 0 0 50px rgba(0, 229, 255, 0.5);
        }

        /* =========================================
           RESPONSIVE & FLOATING BOX NAV BAR FOR MOBILE
        ========================================= */
