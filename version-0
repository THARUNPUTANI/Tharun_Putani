    <style>
        :root {
            --bg-base: #09090e;
            --glass-bg: rgba(20, 20, 35, 0.4);
            --glass-border: rgba(255, 255, 255, 0.1);
            --accent-cyan: #00e5ff;
            --accent-magenta: #ff007f;
            --accent-violet: #7000ff;
            --text-main: #ffffff;
            --text-muted: #a1a1aa;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* =========================================
           ADOBE-STYLE FLUID BACKGROUND
        ========================================= */
        .adobe-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -1;
            overflow: hidden;
            background: var(--bg-base);
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.5;
            animation: float 20s infinite alternate ease-in-out;
        }

        .blob-1 { width: 600px; height: 600px; background: var(--accent-magenta); top: -10%; left: -10%; animation-duration: 25s; }
        .blob-2 { width: 700px; height: 700px; background: var(--accent-violet); bottom: -20%; right: -10%; animation-duration: 22s; animation-delay: -5s; }
        .blob-3 { width: 500px; height: 500px; background: var(--accent-cyan); top: 40%; left: 40%; animation-duration: 28s; animation-delay: -10s; }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(50px, 80px) scale(1.1); }
            100% { transform: translate(-50px, -40px) scale(0.9); }
        }

        /* =========================================
           LAYOUT & PANELS
        ========================================= */
        .container {
            display: flex;
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            min-height: 100vh;
        }

        /* Left Fixed Glass Pane (Desktop) */
        .left-pane {
            width: 38%;
            position: fixed;
            height: 100vh;
            padding: 4rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: rgba(10, 10, 15, 0.4);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-right: 1px solid var(--glass-border);
            z-index: 10;
            overflow-y: auto;
            scrollbar-color: rgba(255, 255, 255, 0.6) rgba(0, 0, 0, 0.3);
            scrollbar-width: thin;
        }

        /* Custom Scrollbar for Left Pane */
        .left-pane::-webkit-scrollbar {
            width: 8px;
        }
        .left-pane::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-left: 1px solid var(--glass-border);
        }
        .left-pane::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.6);
            border-radius: 4px;
        }
        .left-pane::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.9);
        }

        .brand-logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 2rem;
        }

        .brand-logo-container img {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid transparent;
            background: linear-gradient(var(--bg-base), var(--bg-base)) padding-box, 
                        linear-gradient(45deg, var(--accent-cyan), var(--accent-magenta)) border-box;
            cursor: pointer;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .brand-logo-container img:hover {
            transform: scale(1.15) rotate(5deg);
        }

        .brand-logo-container span {
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            background: linear-gradient(45deg, var(--accent-cyan), #ffffff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
        }

        .profile-header h1 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1rem;
            background: linear-gradient(to right, #ffffff, #a1a1aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .bio {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 2rem;
            line-height: 1.7;
        }

        .resume-btn {
            font-family: 'Fira Code', monospace;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(45deg, rgba(255, 0, 127, 0.1), rgba(0, 229, 255, 0.1));
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.8rem 1.5rem;
            border-radius: 30px;
            font-size: 0.9rem;
            text-decoration: none;
            margin-bottom: 1.5rem;
